-- exodus 1-bit
-- caprog

function _init()
	-- black opacity 1
	pal(0, false)

	-- make pink transparent
	palt(14, true)
	
	reset_game()
	
	-- update functions
	upt_dic = {
		intro = {
			upt_intro
		},
	 game = {
	 	upt_game
	 },
	 level_up = {
	 	upt_level_up
	 },
	 game_over = {
	 	upt_game_over
	 }
	}
	
	-- draw functions
	dw_dic = {
		intro= {
			draw_game_scene,
			draw_dialog
		},
		game = {
			draw_game_scene
		},
		level_up = {
			draw_hud,
			draw_level_up
		},
	 game_over = {
	 	draw_game_scene,
	 	draw_dialog
	 }
	}
	
	on_enter = {
		intro = on_intro,
		game = on_game,
		level_up = on_level_up,
		game_over = on_game_over
	}
end

function _update60()
	handle_on_enter_state()
	handle_by_state(upt_dic)
end

function handle_on_enter_state()
	if last_state != state then
		local func = on_enter[state]
		if func then
			func()
		end
		last_state = state
	end
end

function _draw()
 cls()
 handle_by_state(dw_dic)
 --frame
 rect(0,0,127,127,7)
end

function handle_by_state(_dic)
 -- get func to handle 
 -- by the game state
	local funcs = _dic[state]
	for f in all(funcs) do
		f()
	end
end
