-- data and factories --
state = "intro"

planet = {}
moon = {}

-- planet spawn start
start_x=38
start_y=80

-- moon target
target_x=104
target_y=40

-- progress bar
progress_bar = {}

-- auto launch frames
auto_frame=0

rockets = {}
toasts = {}
particles = {}

-- r count
rockets_stock = 0
initial_rockets_stock=10
max_rockets_stock = 10 

btn_x_pressed=false
max_pop=3000
pop=max_pop

crd=0
lunar_pop=0
start_lunar_pop=0
max_lunar_pop=10

--r creation per sec
creation_cooldown=0

-- dialog
dialog_text=""

-- footer right text
footer_text=""

-- time
start_time = nil
elapsed_time = nil

-- on level up
selected=1

-- end level up

function c_planet(
	x,y,r,c,nb_circs
)
	local p = {
	 x=x + r,
	 y=y,
	 r=r,
	 c=c
	}

	return p
end

function c_rocket(x,y,tx,ty,crd,cap)
	local dx,dy = 
		tx - x,
		ty - y
	
	local h =sqrt(dx*dx + dy*dy)
	local spd = 2
	local r = {
		x=x,
		y=y,
		spd=spd,
		tx=x,
		ty=y,
		circfill={r=1},
		cap=cap, -- ship capacity
		crd=crd,
		vx=h == 0 and 0 or (dx/h) * spd,  
		vy=h == 0 and 0 or (dy/h) * spd
	}
	local frame = 0
	r.update = function()
		frame +=1
		if frame%2==0 then
			c_part(
				r.x, 
				r.y,
				{
					life=4,
					circ={r=0}
				}
			)
		end
	end
	
	-- apply current improves
	for i in all(improves) do
		if i.type == "rocket_cap" then
			if i.val then
				r.cap += i.val
			end
		end
	end
	
	return r
end

function c_notif(x,y,text)
	local hw = print(text,0,-20)/2
	local n = {
		x=x - hw,
		y=y - hw,
		life=42,
		vy=-0.4,
		print_t={t=text}
	}
	
	add(toasts, n)
	
	return n 
end

function c_part(x,y,opt)
	local p =  {
		x=x,
		y=y,
		vx=opt and (opt.vx or 0) or 0,
		vy=opt and (opt.vy or 0) or 0,
		life=opt and (opt.life or 16) or 16,
		circ=opt and opt.circ or nil,
		rect=opt and opt.rect or nil,
		update=opt and opt.update or nil
	}
	
	add(particles, p)
	
	return p
end

function c_impact(x,y,size,opt)
		local s_life = rnd(10)+8
		s_life = opt and (opt.life or opt.life) or s_life 
		local opt = {
			 life=s_life,
			 circ={r=1}
			}
			
		local p = c_part(
			x, 
			y,
			opt
		)
			
		p.update = function()
			p.circ={r=(s_life-p.life) * (size or 0.5)}
			p.x = x - p.circ.r
		end
		
		return p
end

function c_progress_bar(x,y,w,h,get_percent)
	local pb = {
		x=x,
		y=y,
		rect={w=w,h=h},
		rectfill={w=0,h=h},
		is_completed=false
	}
	
	pb.update = function()
		local pct = get_percent()
		pb.rectfill.w = (pct * w) / 100
		pb.is_completed = pct >= 100
	end
	
	return pb
end

function c_and_launch_rocket()
		if (pop <= 0) return
		if rockets_stock <= 0 then
			sfx(6)
			return
		end

		
		local r = c_rocket(
			start_x,
			start_y,
			target_x,
			target_y,
			2, -- credits,
			1 -- capacity
		)
		add(rockets, r)
		
		-- update state
		rockets_stock -= 1
		r.cap = pop < r.cap and pop or r.cap
		pop -= r.cap
		local gain = r.crd * r.cap 
		crd += gain
		
		-- popup gain
		c_notif(
			start_x - 4 + (rnd_sgn() * rnd(4)), 
			start_y + (rnd_sgn() * rnd(4)), 
			"$"..gain)
			
		-- sfx
		sfx(rnd({0,1}))
		
		-- impact particle
		c_impact(
			start_x, 
			start_y
		)
		return r
end 
