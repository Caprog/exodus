-- utils stuff --

local signs = {1,-1}

function rnd_sgn()
	return rnd(signs)
end

function to_angle(deg)
	local a = deg/360
	return cos(a), sin(a)
end

function format_time(sec)
	local total_sec = flr(sec)
	local m = flr(total_sec/60)
	local s = total_sec%60
	local s_str = (s<10 and "0" or "")..s
	return m..":"..s_str
end

function get_text_w(t)
	return print(t, 0, -2000)
end

function get_text_hw(t)
	return get_text_w(t)/2
end

function wrap_text(t)
	local t_array = split(t, " ")
	
	local t = ""
	local char_count = 0
	
	for _t in all(t_array) do
		char_count += #tostr(_t)
		t ..=_t .. " "
		
		if char_count > 16 then
			t ..= "\n"
			char_count = 0
		end
	end
	
	return t
end

function print_t(t,x,y)
	print(t,x-1,y-1,0)
	print(t,x-1,y+1,0)
	print(t,x+1,y-1,0)
	print(t,x,y-1,0)
	print(t,x,y+1,0)
	print(t,x+1,y,0)
	print(t,x-1,y,0)
	print(t,x+1,y+1,0)
	print(t,x,y,7)
end

function get_percent(min_val, crt_val, max_val)
		if max_val <= 0 then return 0 end
		
		local percent = (crt_val / max_val) * 100
		
		return mid(min_val, percent, 100)
end
