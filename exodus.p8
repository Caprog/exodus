-- draw stuff --

function draw_game_scene()
	-- planet
	draw_planet(planet)
	draw_planet(moon)
	draw_entities(particles)
	draw_entities(rockets)	
	draw_entities(toasts)
	-- draw rockets qty
	print(
		"★"..rockets_stock..
		"/"..max_rockets_stock,
		40,102,7
	)
	draw_progress(
		40,
		110,
		48,
		2,
		rockets_stock, 
		max_rockets_stock
	)

	-- ui
	draw_hud()
end

function draw_entities(entities)
	for e in all(entities) do
		draw_entity(e)
	end
end

function draw_entity(e)
	if e.circ then
		circ(e.x,e.y,e.circ.r, e.circ.c or 7)
	end
	
	if e.circfill then
		circfill(e.x,e.y,e.circfill.r, e.circfill.c or 7)
	end
	
	if e.rect then
		rect(
			e.x, 
			e.y,
			e.x + e.rect.w, 
			e.y + e.rect.h,
			e.rect.c or 7)
	end
	
	if e.rectfill then
		rectfill(
			e.x, 
			e.y,
			e.x + e.rectfill.w, 
			e.y + e.rectfill.h,
			e.rectfill.c or 7)
	end

	if e.print_t then
		print_t(e.print_t.t, e.x + (e.w or 1), e.y + (e.w or 1), 7)
	end
end

function draw_hud()
	--
	local ml = 4
	local mt = 3
	local sl_y = mt + 7
	local right = 127 - ml - 20
	
	--header
	rectfill(0,0,127,18,0)
	print("pop:" .. pop, ml,mt,7)
	print("crd:$" .. crd, ml,sl_y,7)
	print(
		"moon pop:" .. lunar_pop .. "/" 
		.. max_lunar_pop,
		right - 52, mt, 7
		)
	
	--separator
	line(0, 18, 127, 18, 7)
	
	-- footer bar
	rectfill(0, 118, 127, 127, 7)
	
	-- btn
	local tw = get_text_w(state)
	rectfill(2, 119, 2 + tw + 4, 127, 0)
	
	
	print(state, 5, 120, 7)	
	
	draw_entity(progress_bar)
	
	-- draw footer text
	print(footer_text, 127 - get_text_w(footer_text) ,120,0)
end


function draw_planet(p)
	circfill(
		p.x, 
		p.y, 
		p.r,7)
	
	local offset_x = p.x - p.r
	local offset_y = p.y - p.r
	
	for c in all(p.circs) do
		
		local s = p.r / 8
		circfill(
			offset_x + c[1], 
			offset_y + c[2], 
			s,
			9)
	end
end


function draw_level_up()
	local offset_y = 23
	print("shop", 4,23,7)
	
	offset_y += 10
	local gap = 20
	for i=1,#improves do
		local imp = improves[i]
		local y = offset_y + ((i-1) * gap)
		local x = 22
		local y2= y+6
		local cost_label = "$" .. imp.cdt
		print(imp.label, x, y, 7)
		rectfill(x,y2,x+get_text_w(cost_label),y2+8)
		print(cost_label, x+1, y2+2,0)
		local qt_x = x+get_text_w(cost_label) + 4
		print(imp.val .. "/" .. imp.max, qt_x, y2+2, 7)
	end
	
	-- selector
	spr(3,10, offset_y - 1 + ((selected-1)*gap))
end

function draw_dialog()
	rectfill(0, 40, 127,96,0)
	rect(0, 40, 127,96,7)
	local time_str = "elapsed time: " .. format_time(elapsed_time)
	local rows = #split(dialog_text, "\n") - 1
	print(dialog_text, 64 - get_text_hw(dialog_text), 64 - ((rows/2)*4), 7) 
end


function draw_progress(x,y,w,h,crt_val,max_val)
	local percent = get_percent(0,crt_val,max_val)
	local pb = {
		x=x,
		y=y,
		rect={w=w,h=h},
		rectfill={w=percent/100 * w,h=h}
	}
	
	draw_entity(pb)
end
