-- update state --

function reset_game()
	srand(7)
	
	-- check total time
	start_time = time()
	elapsed_time = 0

	planet = c_planet(8,90,16,7,8)
	moon = c_planet(102,36,8,7,8)
	progress_bar = c_progress_bar(0,18,127,2, function() 
		local target = max_lunar_pop - start_lunar_pop
		if target <= 0 then return 0 end
		
		local current = lunar_pop - start_lunar_pop
		local percent = (current / target) * 100
		
		return mid(0, percent, 100)
	end)
	next_lvl()
end

function next_lvl()
	max_rockets_stock = initial_rockets_stock + (improves[4].val * 5)
	rockets_stock = max_rockets_stock
	start_lunar_pop = lunar_pop or 0
	max_lunar_pop = max_lunar_pop 
		+ flr(max_lunar_pop * 0.80)
	
	max_lunar_pop = min(max_pop, max_lunar_pop)
	upt_entity(progress_bar)
end

function upt_game()
	-- if next level
	if progress_bar.is_completed then
		state = "level_up"
		sfx(3)
	end
	
	-- if end
	if lunar_pop >= max_pop then
		state = "game_over"
		sfx(7)
	end
	
	-- controls
	upt_ctrls()
	
	-- upt rockets
	for r in all(rockets) do
		
		if r.update then
			r.update()
		end
		
		r.tx += r.vx
		r.ty += r.vy
		r.x = flr(r.tx)
		r.y = flr(r.ty)
		
		if abs(target_x - r.x) < r.spd 
			and abs(target_y - r.y) < r.spd  
				then
			
			-- udt data
			lunar_pop += r.cap
			
			c_notif(
				target_x + 4 + (rnd_sgn() * rnd(4)), 
				target_y + (rnd_sgn() * rnd(4)), 
				"+"..r.cap)
			
			-- impact target
			c_impact(
				target_x, 
				target_y,
				0.4
			)
			
			-- sfx
			sfx(2)
			
			-- remove rocket
			del(rockets,r)
		end
	end
	
	upt_parts(toasts)
	upt_parts(particles)
	upt_entity(progress_bar)
	
	-- auto launch
	local auto = improves[1]
	if auto.val > 0 then
		auto_frame -= 1
		if auto_frame <= 0 then
			c_and_launch_rocket()
			auto_frame = 60 / auto.val
		end
	end
	
	r_creation()
end

function r_creation()
	-- base 1 per 2 sec
	local max_cooldown = 60 * (1 - (max(0, (improves[3].val or 0) / 20))) 
	if rockets_stock < max_rockets_stock then
		creation_cooldown -= 1
		local improve_creation = improves[3]
		if creation_cooldown <= 0 then
			creation_cooldown = max_cooldown 
			rockets_stock += 1
		end
	else
		creation_cooldown = max_cooldown
	end
end

function upt_parts(parts)
	for n in all(parts) do
		if n.update then
			n.update()
		end
		upt_part(n)
		if n.dead then
			del(parts, n)
		end
	end
end

function upt_entity(e)
	if e.update then
		e.update()
	end
end

function upt_part(p)
	if p.life then
		if p.vx then
			p.tx = (p.tx or p.x) + p.vx
			p.x = flr(p.tx)
		end
		
		if p.vy then
			p.ty = (p.ty or p.y) + p.vy
			p.y = flr(p.ty)
		end
		
		p.life -= 1
		p.dead = p.life <= 0
	end
end


function upt_ctrls()
	-- send rocket
	if btn(❎) then
		if not btn_x_pressed then
			btn_x_pressed = true
			
			-- launch rocket
			c_and_launch_rocket()
		end
	else
		btn_x_pressed = false
	end
end

function on_level_up() 
	footer_text = "🅾️ continue  ➡️ buy"
end

function upt_level_up()
	local last_selected = selected
	if btnp(⬇️) then
		selected = min(#improves, selected + 1)
	end
	
	if btnp(⬆️) then
		selected = max(1, selected - 1)
	end
	
	if btnp(➡️) then
		local imp = improves[selected]
		if imp 
			and imp.cdt <= crd 
			and imp.val < imp.max then
			sfx(5)
			crd -= imp.cdt
			imp.val += 1
			imp.cdt += flr(imp.cdt_base + (imp.cdt * imp.mlp))
		else
			sfx(6)
		end
	end
	
	if last_selected != selected then
		sfx(4)
	end
	
	if btnp(🅾️) then
		next_lvl()
		state = "game"
	end
	
	last_selected = selected
end

function upt_game_over()
	if btnp(🅾️) then
		run()
	end
end

function upt_intro()
	if btnp(🅾️) then
		state = "game"
	end
end

function on_game_over()
	elapsed_time = time() - start_time
	dialog_text = "elapsed_time: " .. format_time(elapsed_time)
	footer_text = "🅾️ restart game"
end

function on_game()
	footer_text = "❎ send rocket"
end

function on_intro()
	dialog_text = wrap_text("at space y, your mission is: launch " .. pop .. " eccentric billionaires to the moon and charge them handsomely for the ride.")
	footer_text = "🅾️ continue"
end
